<UserControl x:Class="WallpaperApp.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WallpaperApp">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <local:NullOrEmptyToVisibilityConverter x:Key="NoText"/>
    </UserControl.Resources>
    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="252" Margin="0,0,16,16" Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <Grid Height="150">
                                        <Border CornerRadius="12,12,0,0" Background="#000" ClipToBounds="True">
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                        </Border>
                                        <Border CornerRadius="12,12,0,0" Background="#141418"
                                                Visibility="{Binding Thumb, Converter={StaticResource NoText}}">
                                            <TextBlock Text="▶" FontSize="34" Foreground="{StaticResource Muted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsVideo, Converter={StaticResource Bool2Vis}}"/>
                                        </Border>
                                        <Button Content="★" Command="{Binding FavCommand}" Width="30" Height="30"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                Background="#88000000" BorderThickness="0" Cursor="Hand" Foreground="White">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <StackPanel Margin="12,10,12,12">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{Binding ActionLabel}" Command="{Binding ApplyCommand}"
                                                    Style="{StaticResource PrimaryButton}" Width="150"/>
                                            <Button Content="🗑" Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" Width="42"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Empty, Converter={StaticResource Bool2Vis}}">
                <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Muted}" FontSize="14"
                           TextAlignment="Center" MaxWidth="340" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
