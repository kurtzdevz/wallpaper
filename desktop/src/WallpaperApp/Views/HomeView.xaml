<UserControl x:Class="WallpaperApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WallpaperApp">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <local:NullOrEmptyToVisibilityConverter x:Key="NoText"/>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="5" Background="{DynamicResource Surface2}">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" CornerRadius="5" Background="{DynamicResource Accent}"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28">

            <!-- ===== Linha de estatísticas ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Wallpaper Ativo -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentSoft}">
                            <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE7F4;" FontSize="20"
                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Wallpaper Ativo" Foreground="{DynamicResource Muted}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveTitle}" FontSize="16" FontWeight="Bold" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Baixados -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16" Margin="8,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentSoft}">
                            <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE896;" FontSize="20"
                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Baixados" Foreground="{DynamicResource Muted}" FontSize="12"/>
                            <TextBlock Text="{Binding DownloadedCount}" FontSize="24" FontWeight="Bold" Margin="0,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Na Biblioteca -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16" Margin="8,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentSoft}">
                            <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8F1;" FontSize="20"
                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Na Biblioteca" Foreground="{DynamicResource Muted}" FontSize="12"/>
                            <TextBlock Text="{Binding LibraryCount}" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Espaço Usado -->
                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="18,16" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentSoft}">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8B7;" FontSize="20"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Espaço Usado" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                <TextBlock FontSize="16" FontWeight="Bold" Margin="0,3,0,0">
                                    <Run Text="{Binding StorageUsedLabel}"/><Run Text=" / " Foreground="{DynamicResource Muted}"/><Run Text="{Binding StorageCapLabel}" Foreground="{DynamicResource Muted}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding StoragePercent}"/>
                            <TextBlock Text="{Binding StoragePercentLabel}" Foreground="{DynamicResource Muted}"
                                       FontSize="11" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Hero + Recursos ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Hero: Wallpaper Atual -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Height="230">
                    <Grid>
                        <Border CornerRadius="14" Background="{DynamicResource HeroGlow}"/>
                        <Grid Margin="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Wallpaper Atual" FontSize="22" FontWeight="Bold" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveTitle}" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,8,0,0"/>
                                <TextBlock Text="Selecione um wallpaper na biblioteca ou em Descobrir para aplicar."
                                           Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap"
                                           MaxWidth="320" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                <Button Content="Explorar Wallpapers  →" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,18,0,0" Command="{Binding ExploreCommand}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="150" Height="150" CornerRadius="14"
                                    Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xEB9F;" FontSize="40"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Coluna direita: Uso de Recursos + Armazenamento -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE7F4;" FontSize="16"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Uso de Recursos" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- gráfico -->
                                <Grid Grid.Column="0" Width="200" Height="72" ClipToBounds="True" HorizontalAlignment="Left">
                                    <Polygon Points="{Binding CpuArea}" Fill="{DynamicResource ChartFill}" Stretch="Fill"/>
                                    <Polyline Points="{Binding CpuLine}" Stroke="{DynamicResource Accent}" StrokeThickness="2" Stretch="Fill"/>
                                </Grid>
                                <!-- legenda -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Text="CPU" Foreground="{DynamicResource Muted}" FontSize="12" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CpuText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="24,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Ok}" VerticalAlignment="Center"/>
                                            <TextBlock Text="RAM" Foreground="{DynamicResource Muted}" FontSize="12" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RamText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="24,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Disco" Foreground="{DynamicResource Muted}" FontSize="12" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DiskText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="24,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8B7;" FontSize="16"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Armazenamento" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Margin="0,0,0,8">
                                <Run Text="{Binding StorageUsedLabel}" FontWeight="SemiBold"/><Run Text=" de "/><Run Text="{Binding StorageCapLabel}" Foreground="{DynamicResource Muted}"/>
                            </TextBlock>
                            <Grid>
                                <ProgressBar Style="{StaticResource Bar}" Value="{Binding StoragePercent}"/>
                            </Grid>
                            <TextBlock Text="{Binding StoragePercentLabel}" Foreground="{DynamicResource Muted}"
                                       FontSize="11" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Explorar ===== -->
            <Grid Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoft}">
                        <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE774;" FontSize="15"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Explorar" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Navegue pelos wallpapers mais recentes, populares e em destaque."
                                   Foreground="{DynamicResource Muted}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="Explorar  →" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Command="{Binding ExploreCommand}"/>
            </Grid>

            <!-- ===== Em Alta ===== -->
            <Grid Margin="0,22,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xECCA;" FontSize="16"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="Em Alta" FontSize="17" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Wallpapers mais baixados da comunidade." Foreground="{DynamicResource Muted}"
                               FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Content="Ver mais  →" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Command="{Binding ExploreCommand}"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Trending}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <Grid Height="120">
                                    <Border CornerRadius="14,14,0,0" Background="#000" ClipToBounds="True">
                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border CornerRadius="14,14,0,0" Background="#141418"
                                            Visibility="{Binding Thumb, Converter={StaticResource NoText}}"/>
                                    <Border Background="#99000000" CornerRadius="6" Padding="6,2"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                            Visibility="{Binding Is4k, Converter={StaticResource Bool2Vis}}">
                                        <TextBlock Text="4K" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#88000000" CornerRadius="16" Width="32" Height="32"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsVideo, Converter={StaticResource Bool2Vis}}">
                                        <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE768;" FontSize="12"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <StackPanel Margin="12,10,12,12">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE896;" FontSize="12"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadsLabel}" Foreground="{DynamicResource Muted}"
                                                   FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
