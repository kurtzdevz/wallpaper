<Window x:Class="WallpaperApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WallpaperApp"
        Title="WlpBrasil" Height="760" Width="1180" MinWidth="960" MinHeight="600"
        Icon="/assets/WlpBrasil.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:EqualsToBoolConverter x:Key="EqBool"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Barra lateral ===== -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,24,22,18">
                    <TextBlock FontSize="20" FontWeight="Bold">
                        <Run Text="Wlp"/><Run Text="Brasil" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True"
                                 Content="🏠  Início" Command="{Binding NavigateCommand}" CommandParameter="home"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="🧭  Descobrir" Command="{Binding NavigateCommand}" CommandParameter="discover"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="📚  Minha Biblioteca" Command="{Binding NavigateCommand}" CommandParameter="library"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="⭐  Favoritos" Command="{Binding NavigateCommand}" CommandParameter="favorites"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="⬇️  Downloads" Command="{Binding NavigateCommand}" CommandParameter="downloads"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="🖥️  Wallpapers Ativos" Command="{Binding NavigateCommand}" CommandParameter="active"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="⚙️  Configurações" Command="{Binding NavigateCommand}" CommandParameter="settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Conteúdo ===== -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="0"/>
    </Grid>
</Window>
