<Window x:Class="WallpaperApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WallpaperApp"
        Title="WlpBrasil" Height="800" Width="1280" MinWidth="1040" MinHeight="640"
        Icon="/assets/WlpBrasil.ico"
        Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:NullOrEmptyToVisibilityConverter x:Key="NoText"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== BARRA LATERAL ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <Grid>
                <!-- brilho verde na borda esquerda -->
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource SidebarEdge}"/>

                <DockPanel Margin="0">
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,22">
                        <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource LogoBrush}">
                            <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE7F4;" FontSize="20"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="Bold">
                                <Run Text="Wlp"/><Run Text="Brasil" Foreground="{DynamicResource Accent}"/>
                            </TextBlock>
                            <TextBlock Text="Wallpaper Engine BR" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Card de tema (rodapé) -->
                    <Button DockPanel.Dock="Bottom" Margin="16,8,16,18" Cursor="Hand"
                            Command="{Binding ToggleThemeCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="12" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                Background="{DynamicResource AccentSoft}">
                                            <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE771;" FontSize="15"
                                                       Foreground="{DynamicResource Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tema" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                            <TextBlock Text="{Binding ThemeModeLabel}" Foreground="{DynamicResource Text}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Width="52" Height="28" CornerRadius="14"
                                                Background="{DynamicResource AccentSoft}">
                                            <Ellipse x:Name="knob" Width="22" Height="22" Margin="3"
                                                     Fill="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDark}" Value="False">
                                        <Setter TargetName="knob" Property="HorizontalAlignment" Value="Left"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Navegação -->
                    <StackPanel Margin="0,4,0,0">
                        <RadioButton Style="{StaticResource NavItem2}" GroupName="nav" IsChecked="True"
                                     Command="{Binding NavigateCommand}" CommandParameter="home">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE80F;" FontSize="16" Width="28"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Início" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem2}" GroupName="nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="discover">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE774;" FontSize="16" Width="28"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Descobrir" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem2}" GroupName="nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="library">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8F1;" FontSize="16" Width="28"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Minha Biblioteca" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem2}" GroupName="nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="favorites">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE734;" FontSize="16" Width="28"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Favoritos" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem2}" GroupName="nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="downloads">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE896;" FontSize="16" Width="28"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Downloads" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem2}" GroupName="nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="active">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE7F4;" FontSize="16" Width="28"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Wallpapers Ativos" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem2}" GroupName="nav"
                                     Command="{Binding NavigateCommand}" CommandParameter="settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE713;" FontSize="16" Width="28"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Configurações" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ===================== CONTEÚDO ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topo -->
            <Grid Grid.Row="0" Margin="28,20,28,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SectionTitle}" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SectionSubtitle}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Busca -->
                <Grid Grid.Column="1" Width="420" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBox Style="{StaticResource SearchBox}" Padding="38,10,70,10" FontSize="13"
                             Text="{Binding TopSearch, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding TopSearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE721;" FontSize="15"
                               Foreground="{DynamicResource Muted}" Margin="14,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="Buscar wallpapers, criadores ou categorias..." Foreground="{DynamicResource Muted}"
                               Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"
                               Visibility="{Binding TopSearch, Converter={StaticResource NoText}}"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="6" Padding="7,2">
                        <TextBlock Text="Ctrl + K" Foreground="{DynamicResource Muted}" FontSize="11"/>
                    </Border>
                </Grid>

                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE7E7;" Margin="0,0,10,0"/>

                <Border Grid.Column="3" Width="44" Height="44" CornerRadius="12" Background="{DynamicResource LogoBrush}">
                    <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE77B;" FontSize="18"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- View atual -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
