<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema CLARO — só cores. Mesmas chaves do Dark. -->
    <Color x:Key="BgColor">#F4F4F6</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#F0F0F3</Color>
    <Color x:Key="BorderColor">#E2E2E8</Color>
    <Color x:Key="TextColor">#17171C</Color>
    <Color x:Key="MutedColor">#6C6C7A</Color>
    <Color x:Key="AccentColor">#16A34A</Color>
    <Color x:Key="AccentHoverColor">#12833C</Color>
    <Color x:Key="OkColor">#1F9D6B</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}"/>
</ResourceDictionary>
